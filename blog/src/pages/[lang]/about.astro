---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { BLOG_LANGS, DEFAULT_BLOG_LANG, isBlogLang } from '../../utils/blogRouting';

export async function getStaticPaths() {
  return BLOG_LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isBlogLang(langParam)) {
  return Astro.redirect(`/blog/${DEFAULT_BLOG_LANG}/about/`, 302);
}
const lang = langParam;
const appUrl = `/${lang}/records`;

const labels: Record<string, any> = {
  'zh-cn': {
    title: '关于 RailRound',
    subtitle: '个人轨道交通旅行记录、可视化与分析工具。',
    features: '主要功能',
    blog: '查看开发日志',
    back: '返回主应用',
  },
  en: {
    title: 'About RailRound',
    subtitle: 'A personal railway trip tracker, visualizer, and analyzer.',
    features: 'Key Features',
    blog: 'Read the dev log',
    back: 'Back to App',
  },
  'ja-jp': {
    title: 'RailRound について',
    subtitle: '鉄道移動の記録・可視化・分析を行う個人向けツールです。',
    features: '主な機能',
    blog: '開発ログを見る',
    back: 'アプリへ戻る',
  },
  'zh-tw': {
    title: '關於 RailRound',
    subtitle: '個人軌道交通旅程記錄、視覺化與分析工具。',
    features: '主要功能',
    blog: '查看開發日誌',
    back: '返回主應用',
  },
};

const t = labels[lang] || labels.en;
---

<!doctype html>
<html lang={lang}>
<head>
  <BaseHead title={`${t.title} | ${SITE_TITLE}`} description={t.subtitle} />
</head>
<body>
  <Header />
  <main style="max-width:720px;margin:3rem auto;padding:0 1.5rem 4rem">
    <h1 style="font-size:1.8rem;letter-spacing:-0.03em;margin-bottom:0.5rem">{t.title}</h1>
    <p style="color:var(--text-muted);margin:0 0 2rem">{t.subtitle}</p>

    <h2 style="font-size:1.1rem;margin-top:2rem">{t.features}</h2>
    <ul style="padding-left:1.5rem;line-height:2;color:var(--text)">
      <li>行程与线路记录</li>
      <li>Leaflet 交互地图可视化</li>
      <li>里程与统计数据分析</li>
      <li>Suica IC 卡数据导入</li>
      <li>多语言界面支持</li>
    </ul>

    <p style="margin-top:2rem">
      <a href={`/blog/${lang}/`} style="color:var(--accent)">{t.blog}</a>
    </p>

    <div style="margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--border)">
      <a href={appUrl} class="app-return-link" style="color:var(--accent);font-weight:600;display:inline-flex;align-items:center;gap:0.4rem">
        {t.back}
      </a>
    </div>
  </main>
</body>
</html>
