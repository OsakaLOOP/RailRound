      "content": "Here's a brief guide to get you familiar with the basics."
    },
    "welcome": {
      "title": "Welcome to RailLOOP",
      "content": "RailLOOP is a personal railway diary web app designed to help you track and manage your railway journeys, visually presenting and sharing your travel footprints."
    },
    "tabRecords": {
      "title": "Trip Records",
      "content": "This tab is your journey's command center. You can view, add, and manage all railway trip records here, or add them to your collections."
    },
    "addTrip": {
      "title": "First Record",
      "content": "Click the floating 'New Trip' button below to open the session editor."
    },
    "editorModes": {
      "title": "Editor Modes",
      "content": "Choose 'Manual' to pay homage to the craftsmanship of old, or try 'Auto' to leave your fate to the Infinite Improbability Drive."
    },
    "autoPlanningView": {
      "title": "Auto Planning",
      "content": "Select origin and destination here; the system will plan a route prioritized by Shinkansen. Once done, let's continue."
    },
    "closeEditor": {
      "title": "Close Editor",
      "content": "Close it for now. Continue exploring other parts of the ship, don't let the editor block your view."
    },
    "importExport": {
      "title": "Escape Pods",
      "content": "We believe your data belongs to you—provided you know how to back it up. Export your trips to KML/JSON here.　Please bring your own heat shield for atmospheric re-entry."
    },
    "exportMdx": {
      "title": "Embed in Your Blog",
      "content": "You can export any journey as a standalone MDX component and embed it in blogs like Astro, Docusaurus or Next.js. Look for the <> icon on trip cards in the Records tab, or use the export button in your folders."
    },
    "tabMap": {
      "title": "Map Mode",
      "content": "Toggle to view the railway network. Grey segments are unridden, while ridden ones are highlighted. The base map features detailed alignment from OpenRailwayMap. In this version, we introduce you to richer station interactions: long-press and drag between stations to auto-plan."
    },
    "mapPins": {
      "title": "Map Pins",
      "content": "Pin photos or comments to the map here. It's likely sturdier than a certain Joseph's son's cross."
    },
    "closePinEditor": {
      "title": "Exit Pin Mode",
      "content": "The pin editor appears at the bottom. Click the 'X' button or the FAB again to close it."
    },
    "mapLayers": {
      "title": "Map Styles",
      "content": "Switch between dark and light map styles, whether to save battery or match your midnight snacks."
    },
    "tabStats": {
      "title": "Aftermath",
      "content": "Click here for stats. See how much money you've burned on the tracks of this planet and your carbon footprint (TODO)."
    },
    "statsContent": {
      "title": "Railfan Medals",
      "content": "Your total mileage, expenses, and most visited lines are showcased here."
    },
    "finishLogin": {
      "title": "RailLOOP, Easy Peasy",
      "content": "Tutorial finished. We'll open the login screen now. We recommend binding your GitHub account to generate cool SVG cards for show."
    },
    "loginGuide": {
      "title": "Read Agreement",
      "content": "Before you start, please read this 'User Guide' (mostly a disclaimer). If you are an alien, time traveler, or psychic, please ignore the physical limitation clauses."
    }
  },
