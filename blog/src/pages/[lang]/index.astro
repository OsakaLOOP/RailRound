---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import PostArchive from '../../components/PostArchive.astro';
import { SITE_TITLE } from '../../consts';
import { BLOG_LANGS, DEFAULT_BLOG_LANG, isBlogLang } from '../../utils/blogRouting';

export async function getStaticPaths() {
  return BLOG_LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isBlogLang(langParam)) {
  return Astro.redirect(`/blog/${DEFAULT_BLOG_LANG}/`, 302);
}
const lang = langParam;

const allPosts = (await getCollection('blog', ({ id }) => id.startsWith(`${lang}/`))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const I18N: Record<string, { title: string; subtitle: string; description: string }> = {
  'zh-cn': {
    title: '开发日志',
    subtitle: 'RailRound 的开发记录、版本说明与接入文档。',
    description: 'RailRound 的开发记录、版本说明与接入文档。',
  },
  en: {
    title: 'Dev Log',
    subtitle: 'Development logs, release notes, and integration docs for RailRound.',
    description: 'Development logs, release notes, and integration docs for RailRound.',
  },
  'ja-jp': {
    title: '開発ログ',
    subtitle: 'RailRound の開発記録、更新情報、導入ドキュメント。',
    description: 'RailRound の開発記録、更新情報、導入ドキュメント。',
  },
  'zh-tw': {
    title: '開發日誌',
    subtitle: 'RailRound 的開發記錄、版本說明與接入文件。',
    description: 'RailRound 的開發記錄、版本說明與接入文件。',
  },
};
const t = I18N[lang] || I18N.en;
---

<!doctype html>
<html lang={lang}>
<head>
  <BaseHead title={`${t.title} | ${SITE_TITLE}`} description={t.description} />
</head>
<body>
  <Header />
  <PostArchive
    lang={lang}
    allPosts={allPosts}
    posts={allPosts}
    selectedCategory="all"
    title={t.title}
    subtitle={t.subtitle}
  />
</body>
</html>
