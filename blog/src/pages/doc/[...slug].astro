---
import { getCollection } from 'astro:content';
import RedirectPage from '../../components/RedirectPage.astro';
import { DEFAULT_BLOG_LANG, getPostSlug } from '../../utils/blogRouting';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id, data }) => {
    return id.startsWith(`${DEFAULT_BLOG_LANG}/`) && data.category === 'docs';
  });

  return [
    { params: { slug: undefined } },
    ...posts.map((post) => ({
      params: { slug: getPostSlug(post.id, post.data.version) },
    })),
  ];
}

const to = Astro.params.slug
  ? `/blog/${DEFAULT_BLOG_LANG}/doc/${Astro.params.slug}/`
  : `/blog/${DEFAULT_BLOG_LANG}/doc/`;
---

<RedirectPage to={to} message="Redirecting..." />
