---
import { getCollection } from 'astro:content';
import RedirectPage from '../../../components/RedirectPage.astro';
import {
  BLOG_LANGS,
  DEFAULT_BLOG_LANG,
  getPostSlug,
  isBlogLang,
} from '../../../utils/blogRouting';

export async function getStaticPaths() {
  const paths = [];

  for (const lang of BLOG_LANGS) {
    paths.push({ params: { lang, slug: undefined } });

    const posts = await getCollection('blog', ({ id, data }) => {
      return id.startsWith(`${lang}/`) && data.category === 'docs';
    });

    for (const post of posts) {
      paths.push({
        params: {
          lang,
          slug: getPostSlug(post.id, post.data.version),
        },
      });
    }
  }

  return paths;
}

const lang = Astro.params.lang;
const safeLang = isBlogLang(lang) ? lang : DEFAULT_BLOG_LANG;
const to = Astro.params.slug
  ? `/blog/${safeLang}/doc/${Astro.params.slug}/`
  : `/blog/${safeLang}/doc/`;
---

<RedirectPage to={to} message="Redirecting..." />
