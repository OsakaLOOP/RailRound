{
  "name": "railround",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:release-content": "node scripts/validate-release-content.mjs",
    "check:release-content:strict-locales": "node scripts/validate-release-content.mjs --strict-locales",
    "build": "npm run check:release-content && vite build && node scripts/postbuild.js && npm --prefix blog run build && node scripts/merge-blog-dist.js && node scripts/submit-bing-indexing.js",
    "pre-submit": "npm run build && npm --prefix blog run test",
    "rail:mvp:clean-verify:senseki": "tsx src/rail-graph-v1-mvp/verify-senseki-clean.ts",
    "rail:aggregate:verify:patterns": "tsx src/rail-graph-v1-mvp/verify-aggregate-patterns.ts",
    "rail:aggregate:verify:cross-pf": "tsx src/rail-graph-v1-mvp/verify-cross-pattern-pathfinding.ts",
    "rail:aggregate:verify:events": "tsx src/rail-graph-v1-mvp/verify-event-aggregation.ts",
    "rail:aggregate:verify:cross-ws": "tsx src/rail-graph-v1-mvp/verify-aggregate-cross-workspace.ts",
    "rail:events:mileage-verify": "tsx src/rail-graph-v1-mvp/verify-mileage-user-events.ts",
    "build:all": "node scripts/build_all.js",
    "build:package": "tsx scripts/build-package.ts",
    "publish:package": "cd packages/route-slice-preview && npm publish",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@turf/turf": "^7.3.1",
    "edgeone": "^1.2.20",
    "flag-icons": "^7.5.0",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.555.0",
    "react": "^19.2.4",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.4",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1",
    "remark-gfm": "^4.0.1",
    "sweetalert2": "^11.26.24",
    "typescript": "^5.9.3",
    "vite-plugin-sitemap": "^0.8.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.10.13",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "vite": "^7.2.4",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.1.5"
  }
}
