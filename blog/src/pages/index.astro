---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = [...new Set(allPosts.flatMap(p => p.data.tags))].sort();
const categories = ['all', 'dev', 'docs', 'guide', 'release'] as const;

const grouped: Record<string, typeof allPosts> = { all: allPosts };
for (const cat of categories.slice(1)) {
	grouped[cat] = allPosts.filter(p => p.data.category === cat);
}
---

<!doctype html>
<html lang="zh-CN">
<head>
	<BaseHead title={`日志目录 — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
	<Header />
	<div class="page-layout">
		<aside class="sidebar">
			<nav>
				<h4 class="sidebar-title">分类</h4>
				<ul class="sidebar-list">
					{categories.map(cat => (
						<li>
							<a href={cat === 'all' ? '/blog/' : `/blog/?cat=${cat}`}
							   class="sidebar-link">
								{cat === 'all' ? '全部' : Object.keys(grouped).includes(cat) ? cat : cat}
								<span class="count">{grouped[cat]?.length ?? 0}</span>
							</a>
						</li>
					))}
				</ul>

				{allTags.length > 0 && (
					<>
						<h4 class="sidebar-title" style="margin-top:1.5rem">标签</h4>
						<div class="tag-cloud">
							{allTags.map(tag => (
								<a href={`/blog/tags/${tag}/`} class="tag">#{tag}</a>
							))}
						</div>
					</>
				)}
			</nav>
		</aside>

		<main>
			<h1 class="page-title">开发日志</h1>
			<p class="page-sub">记录 RailRound 的开发历程、版本更新与技术文档。</p>

			<ul class="post-list">
				{allPosts.map(post => {
					const { category, tags, version } = post.data;
					const slug = version ? `v${version}` : post.id;
					return (
						<li>
							<a href={`/blog/${category}/${slug}/`} class="post-card">
								<div class="card-meta">
									<span class={`cat-badge cat-${category}`}>{category}</span>
									{version && <span class="ver-badge">v{version}</span>}
									<span class="date"><FormattedDate date={post.data.pubDate} /></span>
								</div>
								<h2 class="card-title">{post.data.title}</h2>
								<p class="card-desc">{post.data.description}</p>
								{tags.length > 0 && (
									<div class="card-tags">
										{tags.map(t => <span class="tag">#{t}</span>)}
									</div>
								)}
							</a>
						</li>
					);
				})}
			</ul>
		</main>
	</div>
</body>
</html>

<style>
	:root {
		--accent: #39C5BB;
		--bg: #0f172a;
		--surface: #1e293b;
		--border: rgba(255,255,255,0.08);
		--text: #e2e8f0;
		--text-muted: #94a3b8;
		--font: 'Inter', system-ui, sans-serif;
	}
	* { box-sizing: border-box; }
	html, body {
		margin: 0; padding: 0;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font);
	}
	.page-layout {
		max-width: 1100px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 2.5rem;
		align-items: start;
	}
	@media (max-width: 720px) {
		.page-layout { grid-template-columns: 1fr; }
		.sidebar { display: none; }
	}
	.sidebar { position: sticky; top: 68px; font-size: 0.82rem; }
	.sidebar-title { color: var(--text-muted); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.5rem; }
	.sidebar-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.1rem; }
	.sidebar-link { display: flex; align-items: center; justify-content: space-between; padding: 0.3rem 0.6rem; border-radius: 6px; color: #64748b; text-decoration: none; transition: all 0.15s; }
	.sidebar-link:hover { color: var(--text); background: rgba(255,255,255,0.05); }
	.count { background: rgba(255,255,255,0.07); color: #64748b; padding: 0.05rem 0.4rem; border-radius: 99px; font-size: 0.7rem; }
	.tag-cloud { display: flex; flex-wrap: wrap; gap: 0.35rem; }
	.tag { color: #475569; text-decoration: none; font-size: 0.75rem; padding: 0.15rem 0.4rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.06); transition: all 0.15s; }
	.tag:hover { color: var(--accent); border-color: rgba(57,197,187,0.3); }
	.page-title { font-size: 1.8rem; font-weight: 700; letter-spacing: -0.03em; color: #f8fafc; margin: 0 0 0.4rem; }
	.page-sub { color: var(--text-muted); margin: 0 0 2rem; font-size: 0.95rem; }
	.post-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
	.post-card { display: block; padding: 1.25rem 1.5rem; background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 12px; text-decoration: none; transition: all 0.2s; }
	.post-card:hover { background: rgba(255,255,255,0.04); border-color: rgba(57,197,187,0.25); transform: translateY(-1px); }
	.card-meta { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; font-size: 0.78rem; }
	.cat-badge { padding: 0.1rem 0.5rem; border-radius: 99px; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
	.cat-dev    { background: rgba(139,92,246,0.15); color: #a78bfa; }
	.cat-docs   { background: rgba(59,130,246,0.15);  color: #60a5fa; }
	.cat-guide  { background: rgba(34,197,94,0.15);   color: #4ade80; }
	.cat-release{ background: rgba(57,197,187,0.15);  color: #39C5BB; }
	.ver-badge { background: rgba(57,197,187,0.1); color: #39C5BB; padding: 0.1rem 0.45rem; border-radius: 5px; font-size: 0.68rem; font-weight: 700; font-family: monospace; }
	.date { color: var(--text-muted); }
	.card-title { font-size: 1.05rem; font-weight: 600; color: #f1f5f9; margin: 0 0 0.35rem; letter-spacing: -0.01em; }
	.card-desc { color: #64748b; font-size: 0.875rem; margin: 0 0 0.6rem; line-height: 1.55; }
	.card-tags { display: flex; gap: 0.3rem; flex-wrap: wrap; }
	.card-tags .tag { font-size: 0.72rem; border: none; background: none; padding: 0; color: #475569; }
</style>
