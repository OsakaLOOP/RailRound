---
interface Props {
  to: string;
  message?: string;
}

const { to, message = 'Redirecting...' } = Astro.props;
const canonicalURL = new URL(to, Astro.site);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,follow" />
  <meta http-equiv="refresh" content={`0;url=${to}`} />
  <title>{message}</title>
  <link rel="canonical" href={canonicalURL} />
</head>
<body>
  <p>{message}</p>
  <p><a href={to}>Continue</a></p>
  <script is:inline>
    window.location.replace({JSON.stringify(to)});
  </script>
</body>
</html>
