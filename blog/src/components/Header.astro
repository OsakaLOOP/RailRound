---
import { SITE_TITLE } from '../consts';
import { DEFAULT_BLOG_LANG, isBlogLang } from '../utils/blogRouting';

const firstSegment = Astro.url.pathname.replace(/^\/blog\/?/, '').split('/').filter(Boolean)[0];
const lang = isBlogLang(firstSegment) ? firstSegment : DEFAULT_BLOG_LANG;
const base = `/blog/${lang}/`;
const appUrl = `/${lang}/records`;

const labels: Record<string, { home: string; about: string; back: string }> = {
  'zh-cn': { home: '首页', about: '关于', back: '返回主应用' },
  en: { home: 'Home', about: 'About', back: 'Back to App' },
  'ja-jp': { home: 'ホーム', about: '概要', back: 'アプリへ戻る' },
  'zh-tw': { home: '首頁', about: '關於', back: '返回主應用' },
};

const t = labels[lang] || labels.en;
---

<header class="site-header">
  <nav class="header-nav">
    <div class="header-left">
      <a href={appUrl} class="back-link app-return-link" title={t.back}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 5l-7 7 7 7" />
        </svg>
        <span>App</span>
      </a>
      <span class="divider">|</span>
      <a href={base} class="brand">{SITE_TITLE}</a>
    </div>
    <div class="header-right">
      <a href={base} class="nav-link">{t.home}</a>
      <a href={`${base}about/`} class="nav-link">{t.about}</a>
      <a href={`${base}rss.xml`} class="nav-link rss" title="RSS Feed">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20 4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
        </svg>
        RSS
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .header-nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: #94a3b8;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    transition: all 0.15s;
  }
  .back-link:hover {
    color: #39c5bb;
    background: rgba(57, 197, 187, 0.1);
  }

  .divider {
    color: rgba(255,255,255,0.15);
    font-size: 0.9rem;
  }

  .brand {
    color: #f1f5f9;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .brand:hover {
    color: #39c5bb;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    color: #94a3b8;
    font-size: 0.82rem;
    text-decoration: none;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .nav-link:hover {
    color: #f1f5f9;
    background: rgba(255,255,255,0.07);
  }

  .rss {
    color: #f97316;
  }
  .rss:hover {
    color: #fb923c;
    background: rgba(249, 115, 22, 0.1);
  }
</style>

<script>
  document.addEventListener('click', function (e) {
    var target = e.target.closest('a.app-return-link');
    if (target) {
      e.preventDefault();
      if (window.opener && !window.opener.closed) {
        window.close();
      } else {
        window.location.href = target.href;
      }
    }
  });
</script>
