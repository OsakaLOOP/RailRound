{
  "name": "@railloop/route-slice-preview",
  "version": "0.1.1",
  "description": "A lightweight Leaflet-based route preview component for MDX blogs, powered by RailLOOP.",
  "type": "module",
  "module": "./dist/index.mjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/route-slice-preview.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "leaflet": ">=1.9.0",
    "lucide-react": ">=0.500.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.0",
    "@types/react": "^19.0.0",
    "vite": "^7.0.0"
  },
  "homepage": "https://rail.s3xyseia.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OsakaLOOP/RailRound.git"
  },
  "keywords": [
    "railway",
    "railfan",
    "leaflet",
    "react",
    "mdx",
    "blog",
    "ssr",
    "geojson",
    "route",
    "map",
    "astro"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
